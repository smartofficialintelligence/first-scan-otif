# Copy to .env for local overrides
ENVIRONMENT=local
LOG_LEVEL=INFO
DATA_DIR=data/raw
ARTIFACT_DIR=artifacts
MODEL_PATH=artifacts/model.joblib
MODEL_META_PATH=artifacts/model_meta.json
N_OPTUNA_TRIALS=10
AUTH_MODE=off
API_KEY=
HOST=0.0.0.0
PORT=8080

