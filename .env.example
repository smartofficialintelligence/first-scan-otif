# Copy to .env for local overrides
ENVIRONMENT=local
LOG_LEVEL=INFO
DATA_DIR=data/raw
ARTIFACT_DIR=artifacts
MODEL_PATH=artifacts/model.joblib
MODEL_META_PATH=artifacts/model_meta.json
N_OPTUNA_TRIALS=10
AUTH_MODE=off
API_KEY=
HOST=0.0.0.0
PORT=8080

# Milestone 2 — prefer Cursor environment secrets over .env for cloud agents
# GCP_PROJECT_ID=<your-gcp-project>
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# Milestone 3
FEATURE_FRESHNESS_SLA_HOURS=36

# Milestone 4 — MLflow (file store by default; override for remote/GCS)
# MLFLOW_TRACKING_URI=sqlite:///./artifacts/mlflow.db
# VERTEX_PIPELINE_ROOT=gs://your-bucket/pipeline-root
# GCP_REGION=us-central1

