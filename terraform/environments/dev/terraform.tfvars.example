# Example tfvars — copy to terraform.tfvars locally (gitignored).
# Review the plan (H7) before `terraform apply`.
project_id  = "your-gcp-project-id"
region      = "us-central1"
location    = "US"
name_prefix = "olist-ml"

# LangSmith + Cloud Run (when enable_serving=true):
# - Secret already in SM named langsmith-api-key → leave langsmith_api_key unset
# - Or set langsmith_api_key here (gitignored) and Terraform creates/updates the version
# enable_serving      = true
# langsmith_secret_id = "langsmith-api-key"
# langsmith_project   = "olist-ml-agent"
# langsmith_api_key   = "lsv2_pt_..."
